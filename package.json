{
  "name": "softplace-mvp",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace apps/server run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:server": "npm --workspace apps/server run build",
    "start:server": "npm --workspace apps/server run start",
    "test": "npm --workspace apps/server run test",
    "eval:retrieval": "npm --workspace apps/server run eval:retrieval --",
    "retrieval:shadow:backfill": "npm --workspace apps/server run retrieval:shadow:backfill --",
    "retrieval:evidence:backfill": "npm --workspace apps/server run retrieval:evidence:backfill --",
    "retrieval:shadow:review": "npm --workspace apps/server run retrieval:shadow:review --",
    "retrieval:shadow:report": "npm --workspace apps/server run retrieval:shadow:report --",
    "retrieval:generation:review": "npm --workspace apps/server run retrieval:generation:review --",
    "retrieval:generation:report": "npm --workspace apps/server run retrieval:generation:report --",
    "typecheck": "npm --workspace apps/server run typecheck && npm --workspace apps/mobile run typecheck"
  },
  "engines": {
    "node": "24.x"
  }
}
