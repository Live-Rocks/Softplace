{
  "name": "@softplace/server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval:retrieval": "tsx src/evals/retrieval/runRetrievalEval.ts",
    "retrieval:shadow:backfill": "tsx src/scripts/retrievalShadowBackfill.ts",
    "retrieval:evidence:backfill": "tsx src/scripts/retrievalEvidenceBackfill.ts",
    "retrieval:shadow:review": "tsx src/scripts/retrievalShadowReview.ts",
    "retrieval:shadow:report": "tsx src/scripts/retrievalShadowReport.ts",
    "retrieval:generation:review": "tsx src/scripts/retrievalGenerationReview.ts",
    "retrieval:generation:report": "tsx src/scripts/retrievalGenerationReport.ts"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@softplace/shared": "file:../../packages/shared",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
